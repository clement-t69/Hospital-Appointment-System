@{
    ViewData["Title"] = "Notifications";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">My Notifications</h1>
                </div>
                <section>
                    <hr />

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <a class="little-blue-button mb-3" onclick="window.location.href='@Url.Action("mark_as_read", "account", new { userId = ViewBag.UserId })'" style="margin-right:0px; text-decoration: none; box-shadow:none; width: 100%;">
                        <span class="icon"></span>
                        <div class="text-content fs-6 px-2 fw-bold">
                            <div>✅ Mark all as read</div>
                        </div>
                    </a>

                    <table class="table">
                        <tbody>
                            @if (ViewBag.Notifications == null || ViewBag.Notifications.Count == 0)
                            {
                                <tr>
                                    <td style="text-align: center">No notifications to display.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var n in ViewBag.Notifications)
                                {
                                    <tr>
                                        @if (!n.IsRead)
                                        {
                                            <td style="background-color: #ffe3e3">
                                                <div style="padding: 8px; display: flex; align-items:center; justify-content: space-between;">
                                                    <div>
                                                        <strong>@n.Title</strong>
                                                        <br />@n.Date
                                                        <br />@n.Content
                                                    </div>
                                                    <div style="margin-right: 8px;">
                                                        <form asp-controller="account" asp-action="delete_notification" method="post">
                                                            <input type="hidden" name="id" value="@n.Id" />
                                                            <button type="submit" style="background: none; border: none; cursor: pointer;">🗑️</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <div style="padding: 8px; display: flex; align-items:center; justify-content: space-between;">
                                                    <div>
                                                        <strong>@n.Title</strong>
                                                        <br />@n.Date
                                                        <br />@n.Content
                                                    </div>
                                                    <div style="margin-right: 8px;">
                                                        <form asp-controller="account" asp-action="delete_notification" method="post">
                                                            <input type="hidden" name="id" value="@n.Id" />
                                                            <button type="submit" style="background: none; border: none; cursor: pointer;">🗑️</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </section>
            </div>
        </div>
    </div>

    @section scripts 
    {
        <script>
            function goBack()
            {
                window.history.go(-1);
            }
        </script>
    }
}
else
{
    @section scripts 
    {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}