@{
    ViewData["Title"] = "Messages";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_____________________________________________________________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">My Messages</h1>
                </div>
                <section>
                    <hr />

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <div class="row m-0 w-100">
                        <div class="col" style="border-right: 1px solid #dee2e6;">
                            <div>
                                <h3 class="text-center">Received</h3>
                                <hr />
                            </div>
                            <section style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                                <input type="text" id="messagesSearchInput" name="messagesSearchInput" class="form-control" placeholder="Search..." data-val="false" style="padding:24px; width: 256px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.1), 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1);" />
                                <select id="messagesSearchField" name="messagesSearchField" class="form-select rounded-0" style="width: 128px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1); z-index: 1">
                                    <option value="Date">Date</option>
                                    <option value="Sender">Sender</option>
                                    <option value="Object">Object</option>
                                </select>
                                <button class="btn little-white-button" id="mSearchButton" onclick="location.href='@Url.Action("my_messages", "account")?searchInput=' + document.getElementById('messagesSearchInput').value + '&searchField=' + document.getElementById('messagesSearchField').value;" style="width: 64px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">🔍</button>
                            </section>
                            <table class="table">
                                <tbody>
                                    @if (ViewBag.Messages == null || ViewBag.Messages.Count == 0)
                                    {
                                        <tr>
                                            <td style="text-align: center">No messages found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var m in ViewBag.Messages)
                                        {
                                            @if (m.Id == 0)
                                            {
                                                @if (ViewBag.Messages.Count == 1)
                                                {
                                                    <tr>
                                                        <td colspan="4" style="text-align: center">No messages found.</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr class="big-white-button-table"
                                                    onclick="window.location.href='@Url.Action("message", "account", new { id = @m.Id })';"
                                                    style="cursor: pointer;">
                                                    <td>
                                                        <div style="padding: 8px; display: flex; justify-content: space-between;">
                                                            <div>
                                                                <strong>@m.Object</strong>
                                                                <br />@m.Date
                                                                <br />From <strong>@m.SenderFirstName @m.SenderLastName</strong>
                                                            </div>
                                                            <div style="margin-right: 8px;">
                                                                @if (m.IsRead)
                                                                {
                                                                    <span style="color: gray;"><small>Read</small></span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="color: gray;"><small>Sent</small></span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="col">
                            <div>
                                <h3 class="text-center">Sent</h3>
                                <hr />
                            </div>
                            <section style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                                <input type="text" id="sentMessagesSearchInput" name="sentMessagesSearchInput" class="form-control" placeholder="Search..." data-val="false" style="padding:24px; width: 256px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.1), 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1);" />
                                <select id="sentMessagesSearchField" name="sentMessagesSearchField" class="form-select rounded-0" style="width: 128px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1); z-index: 1">
                                    <option value="Date">Date</option>
                                    <option value="Receiver">Receiver</option>
                                    <option value="Object">Object</option>
                                </select>
                                <button class="btn little-white-button" id="smSearchButton" onclick="location.href='@Url.Action("my_messages", "account")?searchInput=' + document.getElementById('sentMessagesSearchInput').value + '&searchField=' + document.getElementById('sentMessagesSearchField').value;" style="width: 64px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">🔍</button>
                            </section>
                            <table class="table">
                                <tbody>
                                    @if (ViewBag.SentMessages == null || ViewBag.SentMessages.Count == 0)
                                    {
                                        <tr>
                                            <td style="text-align: center">No messages found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var m in ViewBag.SentMessages)
                                        {
                                            @if (m.Id == 0)
                                            {
                                                @if (ViewBag.SentMessages.Count == 1)
                                                {
                                                    <tr>
                                                        <td colspan="4" style="text-align: center">No messages found.</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr class="big-white-button-table"
                                                    onclick="window.location.href='@Url.Action("message", "account", new { id = @m.Id })';"
                                                    style="cursor: pointer;">
                                                    <td>
                                                        <div style="padding: 8px; display: flex; justify-content: space-between;">
                                                            <div>
                                                                <strong>@m.Object</strong>
                                                                <br />@m.Date
                                                                <br />To <strong>@m.ReceiverFirstName @m.ReceiverLastName</strong>
                                                            </div>
                                                            <div style="margin-right: 8px;">
                                                                @if (m.IsRead)
                                                                {
                                                                    <span style="color: gray;"><small>Read</small></span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="color: gray;"><small>Sent</small></span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                            <a class="little-blue-button mb-3" onclick="window.location.href='@Url.Action("send_message", "account")'" style="margin-right:0px; text-decoration: none; box-shadow:none; width: 100%;">
                                <span class="icon"></span>
                                <div class="text-content fs-6 px-2 fw-bold">
                                    <div> 📩 Send a Message</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section scripts 
    {
        <script>
            function goBack()
            {
                window.history.go(-1);
            }
        </script>
    }
}
else
{
    @section scripts 
    {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}