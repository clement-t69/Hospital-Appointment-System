@{
    ViewData["Title"] = "Send Message";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">Send a Message</h1>
                </div>
                <section>
                    <hr />
                    <div class="mb-3">
                        <select class="form-select" style="border-radius: 64px; height: 3rem;" id="Doctor" name="Doctor" required>
                            <option value="" selected disabled>Select Doctor</option>

                            @if (ViewBag.Doctors != null && (ViewBag.Doctors).Count != 0)
                            {
                                @foreach (var d in ViewBag.Doctors)
                                {
                                    <option data-id="@d.UserId" data-firstname="@d.FirstName" data-lastname="@d.LastName" data-specialization="@d.Specialization" data-location="@d.Location">@d.FirstName @d.LastName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <input type="text" class="form-control" id="ObjectContent" name="ObjectContent" placeholder="Object" required></input>
                    </div>

                    <div class="mb-3">
                        <textarea class="form-control" id="MessageContent" name="MessageContent" rows="4" placeholder="Enter your message..." required></textarea>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section scripts {
    <script>
        function goBack() {
            window.history.go(-1);
        }
    </script>
    }
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}