@{
    ViewData["Title"] = "Login or Register";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a class="little-white-button" asp-controller="home" asp-action="index" style="text-decoration: none; width: 85px;">
                    <div class="text-content fs-6 px-2 fw-bold text-center">
                        <div>< Back</div>
                    </div>
                </a>
                <div class="text-center" style="flex-grow: 1;">
                    <h2>Log In or Register</h2>
                </div>
                <div style="width: 100px;"></div>
            </div>
            <section>
                <hr />
                <div class="text-center mb-4">
                    <p class="fs-5">New?</p>
                    <a class="big-blue-button" asp-controller="account" asp-action="register" style="text-decoration: none;">
                        <div class="text-content fs-5 px-3 fw-bold">
                            <div>📝  Register</div>
                        </div>
                    </a>
                </div>
                <div class="text-center">
                    <p class="fs-5">Already have an account?</p>
                    <a class="big-blue-button" asp-controller="account" asp-action="login" style="text-decoration: none;">
                        <div class="text-content fs-5 px-3 fw-bold">
                            <div>🔑  Log In</div>
                        </div>
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>