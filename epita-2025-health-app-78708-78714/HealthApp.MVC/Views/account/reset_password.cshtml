@model HealthApp.MVC.Models.ResetPasswordInputModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div class="text-center" style="flex-grow: 1;">
                <h1 style="font-weight: 700">Reset Password</h1>
            </div>
            <section>
                <form id="resetPasswordForm" asp-controller="account" asp-action="reset_password" method="post">
                    <input type="hidden" asp-for="Email" value="@ViewBag.email" />
                    <input type="hidden" asp-for="Token" value="@ViewBag.token" />
                    <!--<input type="text" asp-for="Token" value="@ViewBag.token" readonly />-->
                    <!--<input type="text" asp-for="Email" value="@ViewBag.email" readonly />-->
                    <div class="text-center">
                        <p>Enter your new Password.</p>
                        <hr />
                    </div>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="NewPassword" type="password" class="form-control" id="NewPassword" name="NewPassword" aria-required="true" placeholder="New Password" style="width: 100%;" />
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" id="ConfirmNewPassword" name="ConfirmNewPassword" aria-required="true" placeholder="Confirm New Password" style="width: 100%;" />
                    </div>
                    <div class="text-center">
                        <button type="submit" class="big-blue-button w-100 btn btn-primary mb-3">
                            <div class="text-content fs-5 px-3 fw-bold">
                                <div>💾 Save your new Password</div>
                            </div>
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}