@{
    ViewData["Title"] = "Prescriptions";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" asp-controller="account" asp-action="edit" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">My Prescriptions</h1>
                </div>
                <section>
                    <hr />
                    <div class="col-md-4" style="border-right: 1px solid #dee2e6;">
                        <div>
                            <h3 class="text-center">My Prescriptions</h3>
                            <hr />
                        </div>
                        <div class="list-group">
                            <!-- FILTER BY NAME, DOCTOR -->
                            <section style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                                <input type="text" id="prescriptionsSearchInput" name="prescriptionsSearchInput" class="form-control" placeholder="Search..." data-val="false" style="padding:24px; width: 540px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.1), 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1);" />
                                <select id="prescriptionsSearchField" name="prescriptionsSearchField" class="form-select rounded-0" style="width: 144px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1); z-index: 1">
                                    <option value="Name">Name</option>
                                    <option value="DoctorLastName">Doctor</option>
                                </select>
                                <button class="btn little-white-button" id="mhSearchButton" onclick="location.href='@Url.Action("patients", "care")?searchInput=' + document.getElementById('prescriptionsSearchInput').value + '&searchField=' + document.getElementById('prescriptionsSearchField').value;" style="width: 112px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">🔍</button>
                            </section>
                            <!-- PRESCRIPTIONS LIST -->
                            @if (ViewBag.Prescriptions != null)
                            {
                                @foreach (var mh in ViewBag.Prescriptions)
                                {
                                    <tr>
                                        <td>
                                            <div class="list-group-item list-group-item-action">
                                                <div class="d-flex w-100 justify-content-between">
                                                    <h5 class="mb-1">Name: @mh.Nale</h5>
                                                    <small>Date: @mh.Date</small>
                                                    <small>Dosage: @mh.Dosage</small>
                                                    <small>Frequency: @mh.Frequency</small>
                                                    <small>Duration: @mh.Duration</small>
                                                    <small>Pharmacy: @mh.Pharmacy</small>
                                                    <small>Expiration Date: @mh.ExpirationDate</small>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
	@section scripts {
        <script>
            function searchPrescriptions()
            {
                var prescriptionsSearchInput = document.getElementById('prescriptionsSearchInput').value;
                var prescriptionsSearchField = document.getElementById('prescriptionsSearchField').value;

                if (prescriptionsSearchInput == "" || prescriptionsSearchField == "")
                {
                    prescriptionsSearchField = "";
                    prescriptionsSearchInput = "";
                }
                else
                {
                    location.href = '@Url.Action("care", "patient")?searchInput=' + prescriptionsSearchInput + '&searchField=' + prescriptionsSearchField;
                }
            }
        </script>
        }
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}