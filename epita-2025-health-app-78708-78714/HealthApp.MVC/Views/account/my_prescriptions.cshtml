@{
    ViewData["Title"] = "Prescriptions";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">My Prescriptions</h1>
                </div>
                <section>
                    <hr />
                    <section style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                        <input type="text" id="prescriptionsSearchInput" name="prescriptionsSearchInput" class="form-control" placeholder="Search..." data-val="false" style="padding:24px; width: 540px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.1), 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1);" />
                        <select id="prescriptionsSearchField" name="prescriptionsSearchField" class="form-select rounded-0" style="width: 144px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1); z-index: 1">
                            <option value="Name">Name</option>
                            <option value="DoctorLastName">Doctor</option>
                        </select>
                        <button class="btn little-white-button" id="mhSearchButton" onclick="location.href='@Url.Action("my_prescriptions", "account")?searchInput=' + document.getElementById('prescriptionsSearchInput').value + '&searchField=' + document.getElementById('prescriptionsSearchField').value;" style="width: 112px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">🔍</button>
                    </section>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Date</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Prescriptions == null || ViewBag.Prescriptions.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="text-align: center">No prescription found.</td>
                                </tr>
                            }                           
                            else
                            {
                                <!-- PRESCRIPTIONS LIST -->
                                @foreach (var p in ViewBag.Prescriptions)
                                {
                                    @if (p.Id == 0)
                                    {
                                        @if (ViewBag.Prescriptions.Count == 1)
                                        {
                                            <tr>
                                                <td colspan="4" style="text-align: center">No prescription found.</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr class="big-white-button-table" data-bs-toggle="modal" data-bs-target="#viewPrescriptionModal-@p.Id" style="cursor: pointer;">
                                            <td style="vertical-align: middle;">@p.Name</td>
                                            <td style="vertical-align: middle;">@p.Date</td>
                                            <td style="vertical-align: middle;">@p.Duration days</td>
                                        </tr>

                                        <!-- VIEW PRESCRIPTION MODAL -->
                                        <div class="modal fade" id="viewPrescriptionModal-@p.Id" tabindex="-1" aria-labelledby="viewPrescriptionModalLabel-@p.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content" style="border-radius: 32px; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="viewPrescriptionModalLabel-@p.Id" style="margin-left: 8px">Prescription</h5>
                                                        <button type="button" class="btn-close" onclick="location.href='@Url.Action("my_prescriptions", "account")';" aria-label="Close" style="margin-right: 6px"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <h5 class="modal-title" style="margin-left: 8px"><strong>@p.Name</strong></h5>
                                                        <div class="d-flex justify-content-between" style="margin-left: 8px; margin-top: 8px">
                                                            <div>
                                                                <p class="mb-2"><strong>Issued Date:</strong> @p.Date</p>
                                                                <p class="mb-2"><strong>Dosage:</strong> @p.Dosage mg</p>
                                                                <p class="mb-2"><strong>Frequency:</strong> @p.Frequency per day</p>
                                                                <p class="mb-2"><strong>Duration:</strong> @p.Duration days</p>
                                                                <p class="mb-2"><strong>Pharmacy:</strong> @p.Pharmacy</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </section>
            </div>
        </div>
    </div>

	@section scripts 
    {
        <script>
            function searchPrescriptions()
            {
                var prescriptionsSearchInput = document.getElementById('prescriptionsSearchInput').value;
                var prescriptionsSearchField = document.getElementById('prescriptionsSearchField').value;

                if (prescriptionsSearchInput == "" || prescriptionsSearchField == "")
                {
                    prescriptionsSearchField = "";
                    prescriptionsSearchInput = "";
                }
                else
                {
                    location.href = '@Url.Action("care", "patient")?searchInput=' + prescriptionsSearchInput + '&searchField=' + prescriptionsSearchField;
                }
            }

            function goBack() 
            {
                window.history.go(-1);
            }

            function close()
            {
			    window.history.go(0);
            }
        </script>
    }
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}