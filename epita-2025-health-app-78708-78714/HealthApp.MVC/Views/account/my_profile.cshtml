@model HealthApp.MVC.Models.ChangeInfoInputModel

@{
    ViewData["Title"] = "Profile";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" asp-controller="account" asp-action="edit" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">My Profile</h1>
                </div>
                <section>
                    <hr />
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <div class="card" style="border-radius: 24px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.2)">
                        <div class="card-body">

                            <a class="little-blue-button mb-1" data-bs-toggle="modal" data-bs-target="#changeInfoModal" style="text-decoration: none; box-shadow:none; margin-left: 488px; width: 96px;">
                                <span class="icon"></span>
                                <div class="text-content px-3" style="display: flex; align-items: center;">
                                    <div>Edit</div>
                                </div>
                            </a>

							@if (ViewBag.IsDoctor == true)
							{
                                <div class="modal fade @(ViewData.ModelState.ErrorCount > 0 && ViewData.ModelState.ContainsKey("ChangeInfo") ? "show d-block" : "")" id="changeInfoModal" tabindex="-1" aria-labelledby="changeInfoModalLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content" style="border-radius: 32px; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="changeInfoModalLabel" style="margin-left: 8px">Change your Information</h5>
                                                <button type="button" class="btn-close" onclick="window.location.href='@Url.Action("my_profile", "account")'" aria-label="Close" style="margin-right: 6px"></button>
                                            </div>
                                            <div class="modal-body">
                                                @if (TempData["ErrorMessage"] != null)
                                                {
                                                    <div class="text-danger">@TempData["ErrorMessage"]</div>
                                                }
                                                <form id="changeInfoForm" asp-controller="account" asp-action="change_info" method="post">

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input type="text" class="form-control" placeholder="@ViewBag.UserFirstName" style="width: 100%; color: black;" readonly />
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input type="text" class="form-control" placeholder="@ViewBag.UserLastName" style="width: 100%; color: black;" readonly />
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input asp-for="Phone" type="phone" class="form-control" id="Phone" name="Phone" aria-required="true" placeholder="Phone Number" style="width: 100%;" value="@ViewBag.UserPhone">
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input asp-for="Address" type="text" class="form-control" id="Address" name="Address" aria-required="true" placeholder="Address" style="width: 100%;" value="@ViewBag.UserAddress">
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <!--<input asp-for="Specialization" type="text" class="form-control" id="Specialization" name="Specialization" aria-required="true" placeholder="Specialization" style="width: 100%;">-->
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <!--<input asp-for="Location" type="text" class="form-control" id="Location" name="Location" aria-required="true" placeholder="Location" style="width: 100%;">-->
                                                    </div>

                                                </form>
                                            </div>
                                            <div class="modal-footer">
                                                <a class="little-blue-button" href="#" onclick="document.getElementById('changeInfoForm').submit(); return false;" style="text-decoration: none;">
                                                    <div class="text-content fs-6 px-2 fw-bold">
                                                        <div>💾 Save your Information</div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
							}
                            else
                            {
                                <div class="modal fade @(ViewData.ModelState.ErrorCount > 0 && ViewData.ModelState.ContainsKey("ChangeInfo") ? "show d-block" : "")" id="changeInfoModal" tabindex="-1" aria-labelledby="changeInfoModalLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content" style="border-radius: 32px; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="changeInfoModalLabel" style="margin-left: 8px">Change your Information</h5>
                                                <button type="button" class="btn-close" onclick="window.location.href='@Url.Action("my_profile", "account")'" aria-label="Close" style="margin-right: 6px"></button>
                                            </div>
                                            <div class="modal-body">
                                                @if (TempData["ErrorMessage"] != null)
                                                {
                                                    <div class="text-danger">@TempData["ErrorMessage"]</div>
                                                }
                                                <form id="changeInfoForm" asp-controller="account" asp-action="change_info" method="post">

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input type="text" class="form-control" placeholder="@ViewBag.UserFirstName" style="width: 100%; color: black;" readonly />
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input type="text" class="form-control" placeholder="@ViewBag.UserLastName" style="width: 100%; color: black;" readonly />
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input asp-for="Phone" type="phone" class="form-control" id="Phone" name="Phone" aria-required="true" placeholder="Phone Number" style="width: 100%;" value="@ViewBag.UserPhone">
                                                    </div>

                                                    <div class="rounded_fields form-label mb-3">
                                                        <input asp-for="Address" type="text" class="form-control" id="Address" name="Address" aria-required="true" placeholder="Address" style="width: 100%;" value="@ViewBag.UserAddress">
                                                    </div>

                                                </form>
                                            </div>
                                            <div class="modal-footer">
                                                <a class="little-blue-button" href="#" onclick="document.getElementById('changeInfoForm').submit(); return false;" style="text-decoration: none;">
                                                    <div class="text-content fs-6 px-2 fw-bold">
                                                        <div>💾 Save your Information</div>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div style="margin-left: 24px">
							<p><strong>@ViewBag.UserFirstName @ViewBag.UserLastName.ToUpper()</strong></p>
							<p>Phone:   @ViewBag.UserPhone</p>
							<p>Addres:  @ViewBag.UserAddress</p>
							@if (ViewBag.IsDoctor == true)
							{
								<p>Specialization: </p>
								<p>Location: </p>
							}
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}