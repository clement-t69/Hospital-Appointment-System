@model HealthApp.MVC.Models.ResetPasswordInputModel

@{
    ViewData["Title"] = "ForgotPassword";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a class="little-white-button" asp-controller="account" asp-action="login" style="text-decoration: none; width: 85px;">
                    <div class="text-content fs-6 px-2 fw-bold text-center">
                        <div>< Back</div>
                    </div>
                </a>
                <div class="text-center" style="flex-grow: 1;">
                    <h2>Forgot Password</h2>
                </div>
                <div style="width: 100px;"></div>
            </div>
            <section>
                <form id="account" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div class="text-center">
                        <p>Use your Email address to reset your password.</p>
                        <hr />
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="rounded_fields form-label mb-4">
                        <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" style="width: 100%;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="big-blue-button w-100 btn btn-primary mb-3">
                            <div class="text-content fs-5 px-3 fw-bold">
                                <div>🔗 Send a link</div>
                            </div>
                        </button>

                        <!-- IMPLEMENT LOGIC TO SEND THE EMAIL -->

                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}