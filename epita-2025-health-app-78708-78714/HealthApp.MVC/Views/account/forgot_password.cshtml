@model HealthApp.MVC.Models.ResetPasswordInputModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a class="little-white-button" asp-controller="account" asp-action="login" style="text-decoration: none; width: 90px; box-shadow:none">
                    <div class="text-content fs-6 px-2 fw-bold text-center">
                        <div>< Back</div>
                    </div>
                </a>
            </div>
            <div class="text-center" style="flex-grow: 1;">
                <h1 style="font-weight: 700">Forgot Password</h1>
                <hr />
            </div>
            <section>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                }
                <form id="ForgotPasswordForm" asp-controller="account" asp-action="forgot_password" method="post">
                    <div class="text-center">
                        <p>Use your Email address to reset your password.</p>
                        <hr />
                    </div>
                    <div class="rounded_fields form-label mb-4">
                        <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" placeholder="john.doe@example.com" style="width: 100%;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="big-blue-button w-100 btn btn-primary mb-3">
                            <div class="text-content fs-5 px-3 fw-bold">
                                <div>🔗 Send a link</div>
                            </div>
                        </button>

                        <!-- IMPLEMENT LOGIC TO SEND THE EMAIL -->

                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}