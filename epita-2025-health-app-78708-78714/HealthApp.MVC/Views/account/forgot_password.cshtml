@model HealthApp.MVC.Models.ResetPasswordInputModel

@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div class="text-center">
                <h2>Forgot Password</h2>
            </div>
            <section>
                <form id="account" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div class="text-center">
                        <p>Use your Email address to reset your password.</p>
                        <hr />
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-4">
                        <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" style="width: 100%;" />
                        <label asp-for="Email" class="form-label">Email</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="text-center">
                        <button id="forgot-password-submit" type="submit" class="w-100 btn btn-lg btn-primary mb-3">Send a link</button>
                        <li class="nav-item" style="list-style-type: none;">
                            <a asp-area="" asp-controller="account" asp-action="login">Back to Login</a>
                        </li>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}