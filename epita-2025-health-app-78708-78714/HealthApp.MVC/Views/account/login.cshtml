@model HealthApp.MVC.Models.LoginInputModel

@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div class="text-center">
                <h2>Login</h2>
            </div>
            <section>
                <form id="account" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div class="text-center">
                        <p>Use your Email address and your Password to Log in.</p>
                        <hr />
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Email" class="form-label">Email</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" style="width: 100%; " />
                        <label asp-for="Password" class="form-label">Password</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3 text-center">
                        <label asp-for="RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="RememberMe" />
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>
                    <div class="text-center">
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary mb-3">Log In</button>
                        <li class="nav-item" style="list-style-type: none;">
                            <a asp-area="" asp-controller="account" asp-action="forgot_password">Forgot Password?</a>
                        </li>
                        <li class="nav-item" style="list-style-type: none;">
                            <a asp-area="" asp-controller="account" asp-action="register">Register</a>
                        </li>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}