@model HealthApp.MVC.Models.LoginInputModel

@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center" style="min-height: 60vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a class="little-white-button" asp-controller="account" asp-action="login_or_register" style="text-decoration: none; width: 90px; box-shadow:none">
                    <div class="text-content fs-6 px-2 fw-bold text-center">
                        <div>< Back</div>
                    </div>
                </a>
            </div>
            <div class="text-center" style="flex-grow: 1;">
                <h1 style="font-weight: 700">Log In to your Account</h1>
            </div>
            <section>
                <form id="loginForm" asp-controller="account" asp-action="login" method="post">
                    <div class="text-center">
                        <p>Use your Email address and your Password to Log in.</p>
                        <hr />
                    </div>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="john.doe@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" style="width: 100%; " />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3 text-center rounded-checkbox">
                        <label asp-for="RememberMe" class="form-label form-check-label mt-2">
                            <input class="form-check-input" asp-for="RememberMe" />
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="big-blue-button w-100 btn btn-primary mb-3">
                            <div class="text-content fs-5 px-3 fw-bold">
                                <div>🔑 Log In</div>
                            </div>
                        </button>
                        <div style="display: flex; flex-direction: column; align-items: center;">
                            <a class="little-white-button" asp-controller="account" asp-action="forgot_password" style="text-decoration: none; width: 200px;">
                                <div class="text-content fs-6 px-2 fw-bold text-center">
                                    <div>Forgot Password?</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}