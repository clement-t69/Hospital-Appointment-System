@model HealthApp.MVC.Models.RegisterInputModel

@{
    ViewData["Title"] = "Register";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                    <div class="text-content fs-6 px-2 fw-bold text-center">
                        <div>&lt; Back</div>
                    </div>
                </a>
            </div>
            <div class="text-center" style="flex-grow: 1;">
                <h1 style="font-weight: 700">Create a new Account</h1>
            </div>
            <section>
                <form id="registerForm" asp-controller="account" asp-action="register" method="post">
                    <div class="text-center">
                        <p>Please provide your credentials to create a new account.</p>
                        <hr />
                    </div>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="FirstName" class="form-control" aria-required="true" placeholder="First Name" style="width: 100%;"  />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="LastName" class="form-control" aria-required="true" placeholder="Last Name" style="width: 100%;"  />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="john.doe@example.com" style="width: 100%; "/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="Phone" class="form-control" aria-required="true" placeholder="Phone Number" style="width: 100%; "/>
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="Address" class="form-control" aria-required="true" placeholder="Address" style="width: 100%; " />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" style="width: 100%; "/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="rounded_fields form-label mb-3">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" style="width: 100%; "/>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="big-blue-button w-100 btn btn-primary mb-3">
                            <div class="text-content fs-5 px-3 fw-bold">
                                <div>📝  Register</div>
                            </div>
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function goBack()
        {
            window.history.go(-1);
        }
    </script>
    }