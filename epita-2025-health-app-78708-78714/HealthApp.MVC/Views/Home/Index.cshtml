@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-justify">
			<h1>Hospital Appointment System</h1>
            <p>
                Welcome on the page of our project.
            </p>
            <h2>Project Overview</h2>
            <p>
                The Hospital Appointment System is a web-based application built using either .NET Core, MVC / Razor Pages or Blazor and a SQL Database. It allows patients to book appointments with doctors while hospital administrators manage doctors and schedules.
            </p>
            <p>
                Semester project for Dorset College by Loris NICOLAY (78714) and Clement THOREZ (78708)
            </p>

            <h2>Functionalities</h2>
            <h3>User Roles & Authentication</h3>
            <ul>
                <li>Patients: Can register, log in, book, view, and cancel appointments.</li>
                <li>Doctors: Can log in, view their schedules, approve or reject appointments.</li>
                <li>Admins: Manage doctors, patients, and appointments.</li>
            </ul>
            <h3>User Management</h3>
            <ul>
                <li>Secure patient registration and profile management.</li>
                <li>Admin-controlled doctor registration and schedule setup.</li>
                <li>Role-based authentication using Microsoft Identity.</li>
            </ul>
            <h3>Appointment Booking & Management</h3>
            <ul>
                <li>Patients can book, view, and cancel appointments.</li>
                <li>Doctors can approve, reject, and complete appointments.</li>
                <li>Admins can view and manage all appointments.</li>
                <li>System prevents double booking and scheduling conflicts.</li>
            </ul>
            <h3>Notifications & Reminders</h3>
            <ul>
                <li>Email confirmation upon booking/cancellation.</li>
                <li>Automated reminders before an appointment.</li>
            </ul>
            <h3>Search & Filtering</h3>
            <ul>
                <li>Patients can search for doctors by specialization or name.</li>
                <li>Appointments can be filtered by date, doctor, or status.</li>
            </ul>
        </div>
    </div>
</div>