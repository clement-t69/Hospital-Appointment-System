<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Appointment System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthApp.styles.css" asp-append-version="true" />
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
        }

        body {
            display: grid;
            grid-template-rows: auto 1fr auto;
        }

        header {
            grid-row: 1;
        }

        .container {
            grid-row: 2;
        }

        footer {
            grid-row: 3;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a asp-area="" asp-controller="home" asp-action="index" class="navbar-brand">
                    <h1 style="text-align: center; font-size: 1.5em; margin: 0;">Hospital Appointment System</h1>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="account" asp-action="my_messages">My Messages</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="account" asp-action="my_appointments">My Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="account" asp-action="edit">My Account</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-dark" style="cursor: pointer;" onclick="document.getElementById('logoutForm').submit();">Log Out</span>
                                <form id="logoutForm" method="post" asp-controller="account" asp-action="logout" style="display: none;"></form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="account" asp-action="login_or_register">Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-center text-muted">
        <div class="container d-flex justify-content-center align-items-center pt-3">
            &copy; NICOLAY Loris and THOREZ Clément - Use only for educational purposes at
            <span class="mx-1"><a href="https://dorset.ie/" target="_blank" rel="noopener noreferrer">Dorset College, Dublin</a></span> - 2025
        </div>
        <div class="container justify-content-center align-items-center pb-3">
            <a class="nav-link" asp-area="" asp-controller="home" asp-action="cancellation_policy">Cancellation Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>