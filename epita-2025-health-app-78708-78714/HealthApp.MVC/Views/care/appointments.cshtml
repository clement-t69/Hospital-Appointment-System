@{
    ViewData["Title"] = "Appointments";
}

@if (ViewBag.IsLogged == true)
{
    <div class="container-fluid p-0" style="min-height: 50vh;">
        <div class="row m-0">
            <div class="col-md-4" style="border-right: 1px solid #dee2e6;">
                <div class="list-group">
                    <div>
                        <h3>My Appointments</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div id="appointmentCalendar" class="mb-3">
                </div>
            </div>
        </div>
    </div>

    <div id="calendarEventsData" style="display: none;">@Html.Raw(Json.Serialize(ViewBag.CalendarEvents))</div>

    @section Scripts {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.2/main.min.css" />
        <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.2/main.min.js"></script>
        <script src="~/js/calendar.js"></script>
    }
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}