    @section scripts
    {
    <script>
        function goBack()
        {
            window.history.go(-1);
        }

        function close()
        {
            window.history.reload();
        }

        $(document).ready(function ()
        {
            $('.calendar-slot button').click(function ()
            {
                var cell = $(this).parent('td');
                var day = cell.index();
                var hour = cell.closest('tr').find('td:first').text().trim();

                var sunday = new Date('@(((DateTime)ViewBag.Sunday).ToString("yyyy-MM-dd"))');
                var selectedDate = new Date(sunday.setDate(sunday.getDate() + (day - 1)));

                var formattedDate = selectedDate.toISOString().slice(0, 10);
                var formattedHour = formatHour(hour);

                $('#appointmentDate').val(formattedDate);
                $('#appointmentHour').val(formattedHour);
            });
        });

        function formatHour(hour)
        {
            var parts = hour.split(':');
            var hours = parseInt(parts[0]);
            var minutes = parts[1].substring(0, 2);
            var ampm = parts[1].substring(3, 5);

            if (hours < 10) {
                hours = hours.toString().padStart(2, '0');
            }

            return hours + ':' + minutes + ' ' + ampm;
        }

        var doctorId = '@ViewBag.DoctorId';

        if (doctorId)
        {
            $('#Doctor').val(function()
