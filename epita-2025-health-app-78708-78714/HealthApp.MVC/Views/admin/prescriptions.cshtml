@{
    ViewData["Title"] = "Prescriptions";
}

@if(ViewBag.IsLogged == true && ViewBag.IsAdmin == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">Prescriptions</h1>
                </div>
                <section>
                    <hr />
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <div class="col-md-4" style="width: 100%">
                        <section style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <input type="text" id="SearchInput" name="SearchInput" class="form-control" placeholder="Search..." data-val="false" style="padding:24px; width: 512px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.1), 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1);" />
                            <select id="SearchField" name="SearchField" class="form-select rounded-0" style="width: 128px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1); z-index: 1">
                                <option value="Date">Date</option>
                                <option value="Patient">Patient</option>
                                <option value="Doctor">Doctor</option>
                            </select>
                            <button class="btn little-white-button" id="SearchButton" onclick="location.href='@Url.Action("prescriptions", "admin")?searchInput=' + document.getElementById('SearchInput').value + '&searchField=' + document.getElementById('SearchField').value;" style="width: 64px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">🔍</button>
                        </section>

                        <table class="table">
                            <tbody>
                                @if (ViewBag.Prescriptions == null || (ViewBag.Prescriptions).Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" style="text-align: center">No Prescription found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (Prescription p in ViewBag.Prescriptions)
                                    {
                                        <!-- PRESCRIPTION DETAILS -->
                                        <tr class="big-white-button-table" data-bs-toggle="modal" data-bs-target="#editPrescriptionModal-@p.Id" style="cursor: pointer;">
                                            <td>
                                                <div style="padding: 8px; mb-3">
                                                    <strong>@p.Date</strong>
                                                    <br />Doctor: <strong>@p.DoctorId</strong>
                                                    <br />Patient: <strong>@p.PatientId</strong>
                                                    <br />Name: @p.Name
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- EDIT PRESCRIPTION MODAL -->
                                        <div class="modal fade" id="editPrescriptionModal-@p.Id" tabindex="-1" aria-labelledby="editPrescriptionModalLabel-@p.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content" style="border-radius: 32px; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="editPrescriptionModalLabel-@p.Id" style="margin-left: 8px">Edit a Medical History</h5>
                                                        <button type="button" class="btn-close" onclick="goBack()" aria-label="Close" style="margin-right: 6px"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <form id="editPrescriptionForm-@p.Id" asp-controller="admin" asp-action="edit_prescription" method="post">
                                                            <input type="hidden" name="Id" value="@p.Id" />

                                                            <div class="rounded_fields form-label mb-3">
                                                                <input type="date" class="form-control" id="editPrescriptionDate-@p.Id" name="Date" aria-required="true" style="width:100%;" value="@p.Date">
                                                            </div>

                                                            <input type="hidden" name="DoctorId" value="@p.DoctorId" />

                                                            <input type="hidden" name="PatientId" value="@p.PatientId" />

                                                            <div class="rounded_fields form-label mb-3">
                                                                <input type="text" class="form-control" id="editPrescriptionName-@p.Id" name="Name" aria-required="true" style="width:100%;" value="@p.Name">
                                                            </div>

                                                            <div class="rounded_fields form-label mb-3">
                                                                <input type="number" class="form-control" id="editPrescriptionDosage-@p.Id" name="Dosage" aria-required="true" style="width:100%;" value="@p.Dosage">
                                                            </div>

                                                            <div class="rounded_fields form-label mb-3">
                                                                <input type="number" class="form-control" id="editPrescriptionFrequency-@p.Id" name="Frequency" aria-required="true" style="width:100%;" value="@p.Frequency">
                                                            </div>

                                                            <div class="rounded_fields form-label mb-3">
                                                                <input type="number" class="form-control" id="editPrescriptionDuration-@p.Id" name="Duration" aria-required="true" style="width:100%;" value="@p.Duration">
                                                            </div>

                                                            <div class="rounded_fields form-label mb-3">
                                                                <input type="text" class="form-control" id="editPrescriptionPharmacy-@p.Id" name="Pharmacy" aria-required="true" style="width:100%;" value="@p.Pharmacy">
                                                            </div>                                                            
                                                        </form>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <a class="little-blue-button" href="#" onclick="document.getElementById('editPrescriptionForm-@p.Id').submit(); return false;" style="text-decoration: none;">
                                                            <div class="text-content fs-6 px-2 fw-bold">
                                                                <div>📝 Edit Prescription</div>
                                                            </div>
                                                        </a>
                                                        <form id="deletePrescriptionForm-@p.Id" asp-controller="admin" asp-action="delete_prescription" method="post" style="display: none;">
                                                            <input type="hidden" name="Id" value="@p.Id" />
                                                        </form>
                                                        <a class="little-blue-button" href="#" onclick="document.getElementById('deletePrescriptionForm-@p.Id').submit(); return false;" style="text-decoration: none;">
                                                            <div class="text-content fs-6 px-2 fw-bold">
                                                                <div>🗑️ Delete Prescription</div>
                                                            </div>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </section>
            </div>
        </div>
    </div>

    @section scripts {
        <script>
            function goBack()
            {
                window.history.go(-1);
            }
        </script>
    }
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("error", "home")';
    </script>
    }
}