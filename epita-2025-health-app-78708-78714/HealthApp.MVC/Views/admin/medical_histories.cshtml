@{
    ViewData["Title"] = "Medical Histories";
}

@if(ViewBag.IsLogged == true && ViewBag.IsAdmin == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">Medical Histories</h1>
                </div>
                <section>
                    <hr />
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <div class="col-md-4" style="width: 100%">
                        <section style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <input type="text" id="SearchInput" name="SearchInput" class="form-control" placeholder="Search..." data-val="false" style="padding:24px; width: 512px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.1), 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1);" />
                            <select id="SearchField" name="SearchField" class="form-select rounded-0" style="width: 128px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.1), 0px -4px 8px -4px rgba(0, 0, 0, 0.1); z-index: 1">
                                <option value="Date">Date</option>
                                <option value="Patient">Patient</option>
                                <option value="Doctor">Doctor</option>
                                <option value="Specialitzation">Specialitzation</option>
                            </select>
                            <button class="btn little-white-button" id="SearchButton" onclick="location.href='@Url.Action("medical_histories", "admin")?searchInput=' + document.getElementById('SearchInput').value + '&searchField=' + document.getElementById('SearchField').value;" style="width: 64px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">🔍</button>
                        </section>

                        <table class="table">
                            <tbody>
                                @if (ViewBag.MedicalHistories == null || (ViewBag.MedicalHistories).Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" style="text-align: center">No medical history found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var mh in ViewBag.MedicalHistories)
                                    {
                                        @if (mh.Id == 0)
                                        {
                                            @if (ViewBag.MedicalHistories.Count == 1)
                                            {
                                                <tr>
                                                    <td colspan="4" style="text-align: center">No medical history found.</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                        <!-- MEDICAL HISTORIES DETAILS -->
                                            <tr class="big-white-button-table" data-bs-toggle="modal" data-bs-target="#editMHModal-@mh.Id" style="cursor: pointer;">
                                                <td>
                                                    <div style="padding: 8px;" class="mb-3">
                                                        <strong>@mh.Date</strong>
                                                        <br />Doctor: <strong>@mh.DoctorFirstName @mh.DoctorLastName</strong>
                                                        <br />Patient: <strong>@mh.PatientFirstName @mh.PatientLastName</strong>
                                                        <br />Location: @mh.Location
                                                        <br />Specialization: @mh.Specialization
                                                        <br />Diagnosis: @mh.Diagnosis
                                                    </div>
                                                </td>
                                            </tr>

                                            <!-- EDIT MEDICAL HISTORY MODAL -->
                                            <div class="modal fade" id="editMHModal-@mh.Id" tabindex="-1" aria-labelledby="editMHModalLabel-@mh.Id" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content" style="border-radius: 32px; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="editMHModalLabel-@mh.Id" style="margin-left: 8px">Edit a Medical History</h5>
                                                            <button type="button" class="btn-close" onclick="goBack()" aria-label="Close" style="margin-right: 6px"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <form id="editMHForm-@mh.Id" asp-controller="admin" asp-action="edit_medical_history" method="post">
                                                                <input type="hidden" name="Id" value="@mh.Id" />

                                                                <div class="rounded_fields form-label mb-3">
                                                                    <input type="date" class="form-control" id="editMHDate-@mh.Id" name="Date" aria-required="true" style="width:100%;" value="@mh.Date">
                                                                </div>

                                                                <div class="rounded_fields form-label mb-3">
                                                                    <div class="rounded_fields form-label mb-3">
                                                                        <select class="form-control" id="editMHDoctor-@mh.Id" name="DoctorId" aria-required="true" style="width:100%;">
                                                                            <option value="" selected disabled>Select Doctor</option>
																		    @foreach (var d in ViewBag.Doctors)
																		    {
																			    if (d.UserId == mh.DoctorId)
																			    {
																				    <option value="@d.UserId" selected>@d.FirstName @d.LastName</option>
																			    }
																			    else
																			    {
																				    <option value="@d.UserId">@d.FirstName @d.LastName</option>
																			    }
																		    }
                                                                        </select>
                                                                    </div>
                                                                </div>

                                                                <input type="hidden" name="PatientId" value="@mh.PatientId" />

                                                                <div class="rounded_fields form-label mb-3">
                                                                    <input type="text" class="form-control" id="editMHSpe-@mh.Id" name="Specialization" aria-required="true" style="width:100%;" value="@mh.Specialization">
                                                                </div>

                                                                <div class="rounded_fields form-label mb-3">
                                                                    <input type="text" class="form-control" id="editMHLoc-@mh.Id" name="Location" aria-required="true" style="width:100%;" value="@mh.Location">
                                                                </div>

                                                                <div class="rounded_fields form-label mb-3">
                                                                    <input type="text" class="form-control" id="editMHDiag-@mh.Id" name="Diagnosis" aria-required="true" style="width:100%;" value="@mh.Diagnosis">
                                                                </div>
                                                            </form>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <a class="little-blue-button" href="#" onclick="document.getElementById('editMHForm-@mh.Id').submit(); return false;" style="text-decoration: none;">
                                                                <div class="text-content fs-6 px-2 fw-bold">
                                                                    <div>📝 Edit Medical History</div>
                                                                </div>
                                                            </a>
                                                            <form id="deleteMHForm-@mh.Id" asp-controller="admin" asp-action="delete_medical_history" method="post" style="display: none;">
                                                                <input type="hidden" name="Id" value="@mh.Id" />
                                                            </form>
                                                            <a class="little-blue-button" href="#" onclick="document.getElementById('deleteMHForm-@mh.Id').submit(); return false;" style="text-decoration: none;">
                                                                <div class="text-content fs-6 px-2 fw-bold">
                                                                    <div>🗑️ Delete Medical History</div>
                                                                </div>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </section>
            </div>
        </div>
    </div>

    @section scripts {
        <script>
            function goBack()
            {
                window.history.go(-1);
            }
        </script>
    }
}
else
{
    @section scripts {
    <script>
        window.location.href = '@Url.Action("error", "home")';
    </script>
    }
}