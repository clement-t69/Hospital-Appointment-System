@{
    ViewData["Title"] = "Messages";
	var m = ViewBag.Message;
}

@if (ViewBag.IsLogged == true && ViewBag.IsAdmin == true)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                }

                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="font-weight: 700">@m.Object</h1>
					<small style="color: gray;">From <strong>@m.SenderFirstName @m.SenderLastName - @m.Date</strong></small>
                </div>
                <section>
                    <hr />
                    <div>@m.Content</div>
                </section>
            </div>
        </div>
    </div>

    @section scripts 
    {
        <script>
            function goBack()
            {
                window.history.go(-1);
            }
        </script>
    }
}
else
{
    @section scripts 
    {
    <script>
        window.location.href = '@Url.Action("login_or_register", "account")';
    </script>
    }
}