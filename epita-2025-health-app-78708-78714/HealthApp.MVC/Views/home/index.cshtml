@{
    ViewData["Title"] = "Home";
}

<div style="background-color: dodgerblue; height: 40vh; width: 100%; position: absolute; top: 0; left: 0; z-index: -2; border-radius: 64px;"></div>

<div class="container d-flex justify-content-center" style="min-height: 50vh; position: relative;">
    <div class="row justify-content-center">
        <div>
            <div style="color: dodgerblue; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="justify-content: center; align-items: center; margin-top: 16px; margin-bottom: 48px">
                <div class="text-center" style="flex-grow: 1;">
                    <h1 style="color:aliceblue; font-weight: 700">Find care, book fast.</h1>
                </div>
            </div>
            <section style="display: flex; align-items: center; justify-content: center;">
                <input type="text" class="form-control" placeholder="Search..." style="padding:24px; width: 524px; height: 48px; border-radius: 64px 0px 0px 64px; border:none; box-shadow: -4px 0px 8px -4px rgba(0, 0, 0, 0.3), 0px 4px 8px -4px rgba(0, 0, 0, 0.3), 0px -4px 8px -4px rgba(0, 0, 0, 0.3);" />
                <select class="form-select rounded-0" style="width: 160px; height: 48px; border-width:1px; box-shadow: 0px 4px 8px -4px rgba(0, 0, 0, 0.3), 0px -4px 8px -4px rgba(0, 0, 0, 0.3); z-index: 1">
                    <option value="doctor">Doctor</option>
                    <option value="location">Location</option>
                    <option value="specialization">Specialization</option>
                </select>
                <button class="btn little-white-button" style="width: 112px; height: 48px; border-radius: 0px 64px 64px 0px; display: flex; align-items: center; justify-content: center; border-width:1px;">Search 🔍</button>
            </section>
            <section style="margin-bottom: 48px">
                <div class="text-center" style="flex-grow: 1; margin-top: 128px">
                    <h2 style="font-weight: 700">Your everyday partner</h2>
                </div>
				<div class="row justify-content-center" style="margin-top: 32px">
                    <div class="col-4" style="display: flex; flex-direction: column; align-items: center;">
                        <div class="card mb-3" style="width: 96px; height: 96px; border-radius: 64px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1); z-index: -1; background-color: dodgerblue; display: flex; align-items: center; justify-content: center;">
                            <p style="user-select:none; font-size: 48px; margin: 0;">📆</p>
                        </div>
						<div class="card" style="border-radius: 24px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
							<div class="card-body">
                                <h5 class="card-title accept-policy" style="font-weight: 700">Book Appointments</h5>
								<p class="card-text">Find the right doctor for you and book an appointment in seconds.</p>
							</div>
						</div>
					</div>

                    <div class="col-4" style="display: flex; flex-direction: column; align-items: center;">
                        <div class="card mb-3" style="width: 96px; height: 96px; border-radius: 64px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1); z-index: -1; background-color: dodgerblue; display: flex; align-items: center; justify-content: center;">
                            <p style="user-select:none; font-size: 48px; margin: 0;">📋</p>
                        </div>
                        <div class="card" style="border-radius: 24px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                            <div class="card-body">
                                <h5 class="card-title accept-policy" style="font-weight: 700">Manage Appointments</h5>
                                <p class="card-text">View and manage your appointments with ease.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-4" style="display: flex; flex-direction: column; align-items: center;">
                        <div class="card mb-3" style="width: 96px; height: 96px; border-radius: 64px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1); z-index: -1; background-color: dodgerblue; display: flex; align-items: center; justify-content: center;">
                            <p style="user-select:none; font-size: 48px; margin: 0;">🔔</p>
                        </div>
                        <div class="card" style="border-radius: 24px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.1)">
                            <div class="card-body">
                                <h5 class="card-title accept-policy" style="font-weight: 700">Get Notified</h5>
                                <p class="card-text">Get notified about your appointments and never miss one.</p>
                            </div>
                        </div>
                    </div>
				</div>
            </section>
            <section style="margin-bottom: 32px">
                <div class="row justify-content-center" style="margin-top: 48px">
                    <div class="card mb-3" style="width:98%; border-radius: 32px; border: none; box-shadow: 0px 0px 16px rgba(0, 0, 0, 0.2); background-color: #0e43ad; color:aliceblue">
						<div class="card-body">
                            <h4 class="card-title accept-policy" style="font-weight: 700">Are you a health professional?</h4>
							<p class="card-text">Improve your daily life by joining our platform:</p>
							<ul class="list-group list-group-flush mb-4" style="padding-left: 32px">
								<li>Provide the best care to your patients</li>
								<li>Have a better organization</li>
								<li>Access to a large community of health professionals</li>
							</ul>
                            <a class="little-white-button" asp-controller="home" asp-action="contact" style="text-decoration: none; width: 96px">
                                <div class="text-content fs-6 px-2 fw-bold">
                                    <div>📝 Join</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>