@{
    ViewData["Title"] = "Cancellation Policy";
}

<!-- TEMPORARY TEXT -->

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div class="text-center mb-4">
                <h2>Cancellation Policy</h2>
            </div>
            <section>
                <div class="justify-content-center">
                    <p style="font-size: 1.1em;">We understand that unforeseen circumstances may arise, requiring you to cancel or reschedule an appointment. However, to ensure efficient scheduling and availability for all patients, we have implemented the following cancellation policy:</p>
                    <ul>
                        <li style="font-size: 1.1em;">48-Hour Cancellation Window: Patients may cancel or reschedule their appointment up to 48 hours before the scheduled time without any penalty.</li>
                        <li style="font-size: 1.1em;">Late Cancellations: Cancellations made less than 48 hours before the appointment will not be permitted. In such cases, the appointment will be considered confirmed, and failure to attend may result in applicable fees or restrictions on future bookings.</li>
                        <li style="font-size: 1.1em;">No-Show Policy: If a patient fails to attend an appointment without prior cancellation, it may impact their ability to schedule future visits.</li>
                    </ul>
                    <p style="font-size: 1.1em;">For any cancellations or modifications, please contact our office as soon as possible at [contact information].</p>
                    <p style="font-size: 1.1em;">Thank you for your understanding and cooperation.</p>
                </div>
            </section>
        </div>
    </div>
</div>
