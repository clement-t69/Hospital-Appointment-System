@{
    ViewData["Title"] = "Error";
}

<div class="container d-flex justify-content-center" style="min-height: 50vh;">
    <div class="row justify-content-center">
        <div>
            <div style="color: white; user-select: none;">
                <a>_________________________________________________________________________________________</a>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none;">
                    <div class="text-content fs-6 px-2 fw-bold text-center">
                        <div>&lt; Back</div>
                    </div>
                </a>
            </div>
            <div class="text-center" style="flex-grow: 1; z-index: -1">
                <h1 style="font-weight: 700">Error</h1>
            </div>
            <section>
                <hr />
				<h3>You seem to be lost...</h3>

				<p>We are sorry, an error occurred while processing your request.</p>
                <div class="row d-flex">
                    <p style="display: inline-flex; margin-bottom: 0;">
                        If the problem persists, please contact us&nbsp;
                        <a class="nav-link" asp-area="" asp-controller="home" asp-action="contact" style="display: inline-flex; padding: 0;">here</a>.
                    </p>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function goBack()
        {
            window.history.go(-1);
        }
    </script>
}