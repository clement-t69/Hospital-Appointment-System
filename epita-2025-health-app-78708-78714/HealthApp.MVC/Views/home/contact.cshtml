@model HealthApp.MVC.Models.ContactInputModel

@{
    ViewData["Title"] = "Contact";
	var date = DateTime.Now.ToString("yyyy-MM-dd - hh:mm tt");
}

@if (ViewBag.IsLogged == false)
{
    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none;">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1; z-index: -1">
                    <h1 style="font-weight: 700">Contact</h1>
                </div>
                <section>
                    <hr />
					@if (TempData["SuccessMessage"] != null)
					{
						<div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
					}
					@if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <div class="mb-3">
                        <form id="contactForm" asp-controller="home" asp-action="contact" method="post">
                            <input type="hidden" id="SenderId" name="SenderId" value="f27dde93-f22b-4a81-a322-4336fc5232f4" required />
                            <input type="hidden" id="Date" name="Date" value="@date" required />

                            <div class="rounded_fields mb-3">
                                <input type="email" class="form-control" id="Email" name="Email" placeholder="Your Email" required />
                            </div>

                            <div class="rounded_fields mb-3">
                                <input type="text" class="form-control" id="Object" name="Object" placeholder="Object" required />
                            </div>

                            <div class="rounded_textarea form-label mb-3">
                                <textarea class="form-control" id="Message" name="Message" rows="4" placeholder="Enter your message..." required></textarea>
                            </div>
                        </form>
                    </div>
                    <div style="display: flex; justify-content: flex-end;">
                        <a class="little-blue-button" href="#" onclick="document.getElementById('contactForm').submit(); return false;" style="text-decoration: none;">
                            <div class="text-content fs-6 px-2 fw-bold">
                                <div>📨 Send Message</div>
                            </div>
                        </a>
                    </div>
                </section>
            </div>
        </div>
    </div>
}
else
{
    var user = ViewBag.User;

    <div class="container d-flex justify-content-center" style="min-height: 50vh;">
        <div class="row justify-content-center">
            <div>
                <div style="color: white; user-select: none;">
                    <a>_________________________________________________________________________________________</a>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="little-white-button" onclick="goBack()" style="text-decoration: none; width: 90px; box-shadow:none;">
                        <div class="text-content fs-6 px-2 fw-bold text-center">
                            <div>&lt; Back</div>
                        </div>
                    </a>
                </div>
                <div class="text-center" style="flex-grow: 1; z-index: -1">
                    <h1 style="font-weight: 700">Contact</h1>
                </div>
                <section>
                    <hr />
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-4">@TempData["ErrorMessage"]</div>
                    }

                    <div class="mb-3">
                        <form id="contactForm" asp-controller="home" asp-action="contact" method="post">
                            <input type="hidden" id="SenderId" name="SenderId" value="f27dde93-f22b-4a81-a322-4336fc5232f4" required />
                            <input type="hidden" id="Date" name="Date" value="@date" required />
							<input type="hidden" id="Email" name="Email" value="@user.UserName" required />

                            <div class="rounded_fields mb-3">
                                <input class="form-control" placeholder="@user.UserName" required readonly/>
                            </div>

                            <div class="rounded_fields mb-3">
                                <input type="text" class="form-control" id="Object" name="Object" placeholder="Object" required />
                            </div>

                            <div class="rounded_textarea form-label mb-3">
                                <textarea class="form-control" id="Message" name="Message" rows="4" placeholder="Enter your message..." required></textarea>
                            </div>
                        </form>
                    </div>
                    <div style="display: flex; justify-content: flex-end;">
                        <a class="little-blue-button" href="#" onclick="document.getElementById('contactForm').submit(); return false;" style="text-decoration: none;">
                            <div class="text-content fs-6 px-2 fw-bold">
                                <div>📨 Send Message</div>
                            </div>
                        </a>
                    </div>
                </section>
            </div>
        </div>
    </div>
}

@section Scripts {
	<script>
		function goBack() 
        {
			window.history.go(-1);
		}
	</script>
}